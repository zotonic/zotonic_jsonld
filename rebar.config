{erl_opts, [debug_info, warnings_as_errors]}.
{minimum_otp_vsn, "25"}.

{deps, [
    {zotonic_rdf, "~> 1.2.0"},
    {jsxrecord, "~> 2.3"},
    {euneus, "~> 2.4"}
]}.

{hex, [{doc, ex_doc}]}.

{ex_doc, [
    {source_url, <<"https://github.com/zotonic/zotonic_jsonld">>},
    {extras, [<<"README.md">>, <<"LICENSE">>, <<"NOTICE">>, <<"LICENSE_REVIEW.md">>]},
    {main, <<"readme">>}
]}.


{project_plugins, [rebar3_ex_doc]}.
